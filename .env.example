# Copy this file to detection_of_phishing_websites/.env and fill in your values.
# Never commit .env to Git.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional locally (SQLite is used when empty). REQUIRED on a public host so data survives restarts:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin panel login. Local default is Admin/Admin only while DEBUG=True.
# On a public host you MUST set both, or admin login is disabled.
# ADMIN_USERNAME=choose-a-username
# ADMIN_PASSWORD=choose-a-long-password

# Optional override for the pre-trained ML artifact path
# ML_MODEL_PATH=detection_of_phishing_websites/ml_artifacts/phishguard_model.joblib
